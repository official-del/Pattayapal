# Frontend environment variables
# Copy this file to .env.local for local development or set the same keys in your hosting provider.

# API server base URL without /api.
# Local development:
VITE_API_BASE_URL=http://localhost:5000

# Optional. Defaults to VITE_API_BASE_URL when omitted.
VITE_SOCKET_URL=http://localhost:5000

# Production example:
# VITE_API_BASE_URL=https://api.pattayapal.com
# VITE_SOCKET_URL=https://api.pattayapal.com
